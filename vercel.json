{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": false,
      "modernise/burnsville-v2": true
    }
  },
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "backend/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
